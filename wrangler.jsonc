{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "disco-elysium-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "disco-elysium-bot-db"
    }
  ],
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  "vars": {
    "BOT_ENABLED": "true",
    "WHITELIST_ENABLED": "true",
    "ALLOWED_CHAT_IDS": "",
    "REPLY_PERCENT": "1",
    "MIN_CONTEXT_MESSAGES": "4",
    "MIN_CONTEXT_USERS": "2",
    "CONTEXT_MESSAGE_LIMIT": "10",
    "CONTEXT_WINDOW_MINUTES": "30",
    "MESSAGE_TTL_HOURS": "24",
    "MAX_MESSAGE_CHARS": "400",
    "MAX_UPDATE_AGE_SECONDS": "300",
    "COOLDOWN_SECONDS": "1200",
    "MAX_DAILY_REPLIES_PER_CHAT": "8",
    "CHAT_DAILY_LIMIT_USD": "0.05",
    "CHAT_MONTHLY_LIMIT_USD": "0.50",
    "GLOBAL_DAILY_LIMIT_USD": "0.50",
    "GLOBAL_MONTHLY_LIMIT_USD": "5",
    "OPENAI_MODEL": "gpt-6-luna",
    "MODEL_INPUT_USD_PER_MILLION": "0.10",
    "MODEL_OUTPUT_USD_PER_MILLION": "0.50",
    "MAX_OUTPUT_TOKENS": "220",
    "MAX_REPLY_CHARS": "520"
  }
}
