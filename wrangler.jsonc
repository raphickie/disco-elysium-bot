{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "disco-elysium-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [{"binding":"DB","database_name":"disco-elysium","database_id":"fbd1ca36-2efe-4a39-8294-eaa721b04aba","migrations_dir":"migrations"}],
  "triggers": {"crons":["*/10 * * * *"]},
  "observability": {"enabled":true,"logs":{"enabled":true,"head_sampling_rate":1,"invocation_logs":false,"persist":true}},
  "vars": {
    "WHITELIST_ENABLED":"true",
    "ALLOWED_CHAT_IDS":"-1001890425588,-4922375667",
    "REPLY_PERCENT":"1",
    "COOLDOWN_SECONDS":"900",
    "CONTEXT_WINDOW_MINUTES":"20",
    "HISTORY_HOURS":"48",
    "CHAT_DAILY_USD":"0.10",
    "CHAT_MONTHLY_USD":"1.00",
    "GLOBAL_DAILY_USD":"1.00",
    "GLOBAL_MONTHLY_USD":"10.00",
    "RESERVED_USD_PER_CALL":"0.02",
    "OPENAI_MODEL":"gpt-4.1-mini",
    "OPENAI_INPUT_USD_PER_MILLION":"0.40",
    "OPENAI_OUTPUT_USD_PER_MILLION":"1.60"
  }
}
