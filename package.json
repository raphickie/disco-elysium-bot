{
  "name": "disco-elysium-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Disco Elysium inspired Telegram group voice bot on Cloudflare Workers + D1",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "webhook:set": "node scripts/set-webhook.mjs",
    "check:worker": "wrangler deploy --dry-run --outdir .wrangler-dry-run"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  },
  "engines": {"node": ">=22"}
}
